# Dependencies
node_modules/

**/debug/

# Build output
dist/
*.tsbuildinfo
.astro/
packages/smithy/web/

# Local deb build artifacts (scripts/build-deb.sh logs and .deb output).
# dist-deb/ is the outdir the CI `package` job uses; out/ is the local default.
out/
dist-deb/

# Turbo
.turbo/

# Bun
bun.lockb

# Legacy workspace directory
.elemental/

# Stoneforge test workspace (created by Playwright tests)
.stoneforge-test/
.elemental-test/

# CLI bun-test scratch workspaces. These are created next to the sources by
# older test files and left behind when a run is interrupted (crash, CI
# timeout, Ctrl+C). New tests must use mkdtempSync(tmpdir()) instead — this
# rule only stops leaked test databases from being committed.
__test*_workspace__/

# Local development files
prompt.md

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test coverage
coverage/

# Playwright
.playwright/
test-results/
playwright-report/

# Visual QA checkpoints
checkpoints/


OPENCODE_CONFIG_CONTENT

.npmrc
/.stoneforge/.worktrees/
/.stoneforge/.dashboard-opened

# App-level .stoneforge/ dirs created when a test/server runs with cwd inside
# apps/<app> (the smithy server resolves PROJECT_ROOT from cwd). Local test-run
# data (sync/*.jsonl, *.db, daemon-state.json) — never commit these.
apps/*/.stoneforge/

# SEO tools
tools/seo/.env
tools/seo/output/*.json
tools/seo/service-account.json
